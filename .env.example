B2_S3_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_PREFIX=submissions/
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PRESIGN_EXPIRES_SECONDS=900

# Public, non-secret flag. Set transactional after configuring a provider and rebuild.
# Use manual only to explicitly suspend automatic mail.
NEXT_PUBLIC_EMAIL_DELIVERY_MODE=transactional
# Selected: Daum sender via Supabase HTTPS relay, compatible with Render Free.
# SMTP_PASS belongs in Supabase Function secrets, not the Render app.
# Generate EMAIL_RELAY_SECRET once (32 random bytes, 64 hex characters)
# and store the same secret on Render and Supabase; never prefix NEXT_PUBLIC_.
EMAIL_PROVIDER=supabase-smtp
SUPABASE_EMAIL_RELAY_URL=https://rwysjsmxtpuqekeltwxi.supabase.co/functions/v1/send-transactional-email
EMAIL_RELAY_SECRET=
SMTP_FROM=온사이드 <iamonside@daum.net>
# Alternative: gmail works over HTTPS on Render Free without a purchased domain.
# smtp requires outbound port 465/587 (blocked on Render Free).
# resend requires your own verified sender domain. Configure only the selected provider.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
RESEND_FROM=
EMAIL_TEST_TO=
RESEND_TEST_TO=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

INICIS_ENV=prod
INICIS_MID_PROD=
INICIS_SIGN_KEY_PROD=
INICIS_STDJS_URL_PROD=https://stdpay.inicis.com/stdjs/INIStdPay.js

# Optional UI/config
NEXT_PUBLIC_SUPPORT_EMAIL=iamonside@daum.net
NEXT_PUBLIC_SUPPORT_PHONE=010-8436-9035
NEXT_PUBLIC_BANK_NAME=국민은행
NEXT_PUBLIC_BANK_ACCOUNT=073001-04-276967
NEXT_PUBLIC_BANK_HOLDER=주식회사 빈티지하우스
NEXT_PUBLIC_PRE_REVIEW_PRICE=0
NEXT_PUBLIC_UPLOAD_MAX_MB=1024
NEXT_PUBLIC_AUDIO_UPLOAD_MAX_MB=1024
NEXT_PUBLIC_VIDEO_UPLOAD_MAX_MB=4096
NEXT_PUBLIC_LOGO_PATH=
NEXT_PUBLIC_LOGO_LIGHT_PATH=
NEXT_PUBLIC_LOGO_DARK_PATH=

# Optional notifications / spellcheck
KAKAO_ALIMTALK_WEBHOOK_URL=
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_TEMPLATE_CODE=ONSIDE_OFFICIAL_NOTICE
SPELLCHECK_SERVICE_URL=
SPELLCHECK_SHARED_SECRET=

# Optional OpenAI-backed lyric translation
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.5
OPENAI_TRANSLATION_TIMEOUT_MS=15000

# Optional server-only music catalog search. Never use NEXT_PUBLIC_ for these keys.
# Spotify: approved app access; public artist and album metadata via client credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3: channel identity search (not an album release-date API).
YOUTUBE_DATA_API_KEY=
